# ---------------------------------------------------------------------------
# Google Gemini
# ---------------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free-tier daily quota is per model, per project. Both drive the tools
# correctly; if one answers "429 ... RequestsPerDay", switch to the other.
#   gemini-3.1-flash-lite   500 requests/day  (a chat turn costs 4-6)
#   gemini-3-flash-preview  higher; answers 503 when busy - the host retries
#   gemini-2.5-flash        404 for projects created after ~2026-06; do not use
GEMINI_MODEL=gemini-3.1-flash-lite

# A little above 0: the host has to choose which suggestion index to click, and
# hard-zero makes it brittle when the list order shifts.
GEMINI_TEMPERATURE=0.2

# How many tool round-trips before the host gives up on one question.
# open -> enter -> select -> extract is four, so leave room.
MAX_TOOL_ROUNDS=10

# ---------------------------------------------------------------------------
# Playwright
# ---------------------------------------------------------------------------
# false = you see the browser drive itself, which is the whole point.
# true  = headless, for tests and CI.
WEATHER_HEADLESS=false

# Milliseconds of artificial delay per Playwright action. 300-500 makes the
# browser readable to a human watching it.
WEATHER_SLOW_MO_MS=0

# Navigation / selector timeout.
WEATHER_TIMEOUT_MS=45000
